{
  "name": "emberfall-online",
  "version": "0.1.0",
  "private": true,
  "description": "Браузерная 2D MMORPG: Phaser 3 + Colyseus + SQLite",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "assets": "tsx tools/gen-assets.ts",
    "predev": "npm run assets",
    "dev": "concurrently -k -n server,client -c cyan,magenta \"tsx watch --clear-screen=false server/src/index.ts\" \"vite\"",
    "build": "npm run assets && vite build",
    "start": "npm run build && tsx server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx tests/bots.ts && tsx tests/arena.ts && tsx tests/trade.ts && tsx tests/admin.ts",
    "test:trade": "tsx tests/trade.ts && tsx tests/admin.ts",
    "test:arena": "tsx tests/arena.ts",
    "screenshot": "tsx tests/screenshot.ts",
    "screenshot:arena": "tsx tests/arena-screens.ts",
    "db": "tsx tools/db.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "colyseus.js": "^0.16.22",
    "express": "^4.22.3",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^10.0.6",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
